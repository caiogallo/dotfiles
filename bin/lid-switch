#!/usr/bin/env bash

option=$1

case "$option" in
	"open")
		hyprctl dispatch dpms on
        disabled=$(hyprctl monitors -j | jq -r '.[] | select(.name == "eDP-1").disabled')
		if [[ -z "$disabled" ]]; then
			hyprctl eval 'hl.monitor({ output = "eDP-1", mode = "2880x1800@120", position = "0x0", scale = 2, disabled = false })'
		fi
		;;
	"close")
		hyprctl dispatch dpms off
		hyprlock
		;;
esac
