#!/usr/bin/env bash

option=$1

case "$option" in
	"open")
		hyprctl dispatch dpms on
        disabled=$(hyprctl monitors -j | jq -r '.[] | select(.name == "eDP-1").disabled')
		if [[ -z "$disabled" ]]; then
			hyprctl keyword monitor "eDP-1,2880x1800@120,0x0,2"
		fi
		;;
	"close")
		hyprctl dispatch dpms off
		hyprlock
		;;
esac
