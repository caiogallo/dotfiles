#!/usr/bin/env bash

DEVICE="asuf1208:00-2808:0218-touchpad"
STATE_FILE="${XDG_RUNTIME_DIR}/hyprland-touchpad-enabled"

if [[ -f "$STATE_FILE" ]]; then
    rm "$STATE_FILE"
    hyprctl eval "hl.device({ name = '$DEVICE', enabled = true })"
    notify-send -u low "Touchpad" "Ativado"
else
    touch "$STATE_FILE"
    hyprctl eval "hl.device({ name = '$DEVICE', enabled = false })"
    notify-send -u low "Touchpad" "Desativado"
fi
